<privacy-mask show="{{masked}}" />

<view class="page">
  <view wx:if="{{initError}}" class="errbar">
    <text class="errbar__t">{{initError}}</text>
    <view class="errbar__btn" bindtap="onRetry">重试</view>
  </view>

  <view class="sec">
    <view class="sec__head">
      <text class="sec__t">{{ledgerName}}</text>
      <text class="sec__n">{{count}} / {{max}} 人</text>
    </view>
    <view wx:for="{{members}}" wx:key="key" class="row">
      <view class="row__avatar">👤</view>
      <view class="row__main">
        <text class="row__name">{{item.name}}<text wx:if="{{item.isMe}}" class="row__me">（我）</text></text>
        <text class="row__role">{{item.roleText}}</text>
      </view>
      <view wx:if="{{item.canRemove}}" class="row__btn row__btn--del"
        data-key="{{item.key}}" data-name="{{item.name}}" bindtap="onRemove">移除</view>
    </view>
    <view wx:if="{{!members.length}}" class="empty">暂无成员</view>
  </view>

  <view wx:if="{{isOwner}}" class="sec">
    <view class="sec__head">
      <text class="sec__t">邀请家人</text>
      <view class="ihelp" data-t="邀请码 7 天内有效。未认证小程序若无法分享，点「复制」把邀请码通过微信聊天发给家人，让对方在下方「用邀请码加入」里输入即可。" bindtap="onTipTap">!</view>
    </view>
    <view class="inv">
      <text class="inv__code">{{inviteCode || '------'}}</text>
      <view class="inv__ops">
        <view class="inv__btn" bindtap="onCopyCode">复制</view>
        <view class="inv__btn" bindtap="onRotate">刷新</view>
      </view>
    </view>
    <button class="share" open-type="share">分享给家人</button>
  </view>

  <view wx:else class="tip tip--pad">仅房主可邀请成员、查看与刷新邀请码。</view>

  <view class="sec">
    <view class="sec__head">
      <text class="sec__t">用邀请码加入</text>
      <view class="ihelp" data-t="加入后会自动切换到该账本；人数上限 {{max}} 人。" bindtap="onTipTap">!</view>
    </view>
    <view class="join">
      <input class="join__input" value="{{joinCode}}" placeholder="6 位邀请码" maxlength="6" bindinput="onJoinInput" />
      <view class="join__btn" bindtap="onJoinPaste">粘贴</view>
      <view class="join__btn join__btn--go" bindtap="onJoinSubmit">加入</view>
    </view>
  </view>

  <view wx:if="{{!isOwner}}" class="leave" bindtap="onLeave">退出该账本</view>
</view>
