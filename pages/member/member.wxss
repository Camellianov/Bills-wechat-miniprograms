.page {
  min-height: 100vh;
  background: var(--bg);
}

.errbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--line2);
}
.errbar__t { flex: 1; color: var(--text2); font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
}

.sec {
  margin: 24rpx 32rpx;
  padding: 28rpx 24rpx;
  background: var(--card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow);
}
.sec__head { display: flex; align-items: center; padding-bottom: 20rpx; }
.sec__t { font-size: 30rpx; font-weight: 600; }
.sec__n { margin-left: auto; color: var(--sub); font-size: 24rpx; }

/* 辅助说明收进「!」符号 */
.ihelp {
  width: 36rpx;
  height: 36rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--line2);
  color: var(--sub);
  font-size: 22rpx;
}

/* 成员行：不画分割线，靠留白区隔 */
.row {
  display: flex;
  align-items: center;
  height: 104rpx;
}
.row__avatar {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--line2);
  font-size: 28rpx;
}
.row__main { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.row__name { font-size: 28rpx; }
.row__me { color: var(--sub); font-size: 22rpx; }
.row__role { margin-top: 4rpx; color: var(--sub); font-size: 22rpx; }
.row__btn { margin-left: 20rpx; color: var(--brand-text); font-size: 26rpx; }
/* 移除弱化，不用红色 */
.row__btn--del { color: var(--sub); }

.empty { padding: 60rpx 0; text-align: center; color: var(--sub); font-size: 26rpx; }

/* 邀请码 */
.inv { display: flex; align-items: center; }
.inv__code {
  flex: 1;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}
.inv__ops { display: flex; gap: 16rpx; }
.inv__btn {
  padding: 12rpx 24rpx;
  border-radius: var(--r-m);
  background: var(--line2);
  color: var(--text2);
  font-size: 24rpx;
}

.share {
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 16rpx;
  border-radius: var(--r-m);
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.share::after { border: 0; }

.tip { color: var(--sub); font-size: 22rpx; }
.tip--pad { padding: 24rpx 32rpx; }

/* 用邀请码加入 */
.join { display: flex; align-items: center; gap: 16rpx; }
.join__input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-m);
  background: var(--line2);
  font-size: 32rpx;
  letter-spacing: 4rpx;
}
.join__btn {
  padding: 0 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-m);
  background: var(--line2);
  color: var(--text2);
  font-size: 28rpx;
}
.join__btn--go { background: var(--brand); color: #fff; }

/* 退出：描边弱化，不做红色警示 */
.leave {
  margin: 24rpx 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-m);
  border: 1rpx solid var(--line);
  color: var(--text2);
  font-size: 30rpx;
}
