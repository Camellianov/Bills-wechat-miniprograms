.page {
  min-height: 100vh;
  background: var(--bg);
}

.errbar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #fff2f0;
  border-bottom: 2rpx solid #ffd6cf;
}
.errbar__t { flex: 1; color: #c0341b; font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--expense);
  color: #fff;
  font-size: 24rpx;
}

.sec {
  margin: 24rpx 28rpx 0;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
}
.sec__head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.sec__t { font-size: 28rpx; font-weight: 600; }
.sec__n { margin-left: auto; color: var(--sub); font-size: 22rpx; }

.row {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.row:last-child { border-bottom: 0; }
.row__avatar { font-size: 40rpx; }
.row__main {
  margin-left: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.row__name { font-size: 28rpx; }
.row__me { color: var(--brand); font-size: 24rpx; }
.row__role { margin-top: 4rpx; color: var(--sub); font-size: 22rpx; }
.row__btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}
.row__btn--del {
  background: rgba(255, 91, 74, 0.12);
  color: var(--expense);
}

.empty { padding: 32rpx 0; text-align: center; color: #c2c8d2; font-size: 26rpx; }

.inv {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.inv__code {
  flex: 1;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}
.inv__ops { display: flex; gap: 12rpx; }
.inv__btn {
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 26rpx;
}

.share {
  margin: 0 24rpx 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.share::after { border: 0; }

.join {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}
.join__input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f6f7f9;
  font-size: 32rpx;
  letter-spacing: 6rpx;
}
.join__btn {
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 26rpx;
}
.join__btn--go { background: var(--brand); color: #fff; }

.tip { color: var(--sub); font-size: 22rpx; }
.tip--pad { padding: 16rpx 24rpx 20rpx; }

.leave {
  margin: 40rpx 28rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--card);
  color: var(--expense);
  font-size: 30rpx;
}
