/* 页面：卡片浮在浅底上，块与块之间留白，不做通栏白条堆叠 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* 顶部：账本 + 月份，白色导航区 */
.lbar {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  background: var(--card);
}
.lbar__name {
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.lbar__btn {
  margin-left: auto;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: var(--brand-weak);
  color: var(--brand-text);
  font-size: 24rpx;
}
.lbar__btn--sec { margin-left: 16rpx; }

.mbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 32rpx 32rpx;
  background: var(--card);
}
.mbar__arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: var(--line2);
}
.mbar__arrow.is-off { opacity: 0.3; }
.mbar__label {
  min-width: 220rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.mbar__member {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--brand-text);
  font-size: 26rpx;
}

/* 合计：三列等宽栅格 */
.sum {
  display: flex;
  margin: 24rpx 32rpx;
  padding: 32rpx 24rpx;
  background: var(--card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow);
}
.sum__col { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sum__k { color: var(--sub); font-size: 22rpx; }
.sum__v {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.sum__v.is-expense { color: var(--expense); }
.sum__v.is-income { color: var(--income); }

/* 预算 */
.budget {
  margin: 0 32rpx 24rpx;
  padding: 28rpx 24rpx;
  background: var(--card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow);
}
.budget__row { display: flex; align-items: baseline; }
.budget__k { color: var(--text2); font-size: 26rpx; }
.budget__pct { margin-left: auto; font-size: 26rpx; font-weight: 600; }
/* 超支不用颜色警示，靠字重与字号加重 */
.budget__pct.is-over { font-size: 30rpx; font-weight: 700; }
.budget__bar {
  margin-top: 20rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line2);
  overflow: hidden;
}
.budget__fill { height: 100%; border-radius: 4rpx; background: var(--brand); }
.budget__fill.is-over { background: var(--expense); }
.budget__tip { display: block; margin-top: 16rpx; color: var(--sub); font-size: 22rpx; }
.budget__tip.is-over { color: var(--text); font-weight: 600; }

/* 列表 */
.body { flex: 1; min-height: 0; }

.grp {
  margin: 0 32rpx 24rpx;
  background: var(--card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.grp__head {
  display: flex;
  align-items: baseline;
  padding: 28rpx 28rpx 12rpx;
}
.grp__day { font-size: 24rpx; font-weight: 600; color: var(--text2); }
.grp__sum { margin-left: auto; font-size: 24rpx; color: var(--sub); }

/* 条目之间不画分割线，靠留白区隔 */
.item {
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 28rpx;
}
.item:last-child { padding-bottom: 16rpx; }
.item__em { font-size: 36rpx; }
.item__main { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; }
.item__name { font-size: 28rpx; }
.item__note { margin-top: 6rpx; font-size: 22rpx; color: var(--sub); }
.item__amt { font-size: 32rpx; font-weight: 600; letter-spacing: 0.5rpx; }
.item__amt.is-expense { color: var(--expense); }
.item__amt.is-income { color: var(--income); }

.empty { padding: 120rpx 0; text-align: center; color: var(--sub); font-size: 26rpx; }
.hint { padding: 32rpx 0; text-align: center; color: var(--sub); font-size: 22rpx; }
.pad { height: 48rpx; }

/* 错误条：极简中性底，不用高饱和红 */
.errbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--line2);
}
.errbar__t { flex: 1; color: var(--text2); font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
}

/* 编辑弹层 */
.emask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 900;
  background: rgba(22, 24, 28, 0.3);
  display: flex;
  align-items: flex-end;
}
.epanel {
  width: 100%;
  max-height: 88vh;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
}
.epanel__title {
  text-align: center;
  font-size: 26rpx;
  color: var(--sub);
  padding-bottom: 24rpx;
}

.eseg { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.eseg__i {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--r-m);
  background: var(--line2);
  color: var(--text2);
  font-size: 26rpx;
}
.eseg__i.is-on { background: var(--brand-weak); color: var(--brand-text); }

.eamt {
  display: flex;
  align-items: baseline;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.eamt__cur { font-size: 32rpx; color: var(--sub); }
.eamt__input { flex: 1; margin-left: 16rpx; font-size: 56rpx; font-weight: 600; }

.ecats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 28rpx 0;
  max-height: 260rpx;
  overflow-y: auto;
}
.ecat {
  width: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: var(--r-m);
  background: var(--line2);
  border: 1rpx solid transparent;
}
.ecat.is-on { background: var(--brand-weak); border-color: var(--brand-line); }
.ecat__em { font-size: 36rpx; }
.ecat__n { margin-top: 8rpx; font-size: 22rpx; color: var(--text2); }

.erow {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid var(--line);
}
.erow__k { width: 96rpx; color: var(--sub); font-size: 26rpx; }
.erow__v { flex: 1; text-align: right; font-size: 28rpx; }
.erow__input { flex: 1; text-align: right; font-size: 28rpx; }

.ebtns { display: flex; gap: 16rpx; margin-top: 32rpx; }
.ebtn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-m);
  font-size: 28rpx;
  font-weight: 600;
}
/* 删除不做红色警示，用描边弱化；保存用实色强调 */
.ebtn--del {
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--text2);
}
.ebtn--cancel { background: var(--line2); color: var(--text2); }
.ebtn--save { background: var(--brand); color: #fff; }
