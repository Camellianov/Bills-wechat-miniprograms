.page {
  min-height: 100vh;
  background: var(--bg);
}

.errbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--line2);
}
.errbar__t { flex: 1; color: var(--text2); font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
}

/* 月份栏 */
.mbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: var(--card);
}
.mbar__arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: var(--line2);
}
.mbar__arrow.is-off { opacity: 0.3; }
.mbar__label {
  min-width: 220rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 收支切换 */
.seg { display: flex; gap: 12rpx; padding: 24rpx 32rpx 0; }
.seg__i {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: var(--card);
  color: var(--sub);
  font-size: 26rpx;
}
.seg__i.is-on { background: var(--brand); color: #fff; }

.card {
  margin: 24rpx 32rpx;
  padding: 32rpx 28rpx;
  background: var(--card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow);
}
.card__t { font-size: 26rpx; color: var(--sub); margin-bottom: 24rpx; }
.card__n { color: var(--sub); font-size: 24rpx; font-weight: 400; }

/* 环形图 */
.piebox {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  margin: 0 auto;
}
.pie { width: 300rpx; height: 300rpx; }
.piecenter {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.piecenter__k { color: var(--sub); font-size: 22rpx; }
.piecenter__v { margin-top: 8rpx; font-size: 40rpx; font-weight: 600; }

/* 图例：不画分割线，靠留白区隔 */
.lg { display: flex; align-items: center; padding: 12rpx 0; }
.lg__dot { width: 16rpx; height: 16rpx; border-radius: 8rpx; }
.lg__em { margin-left: 16rpx; font-size: 30rpx; }
.lg__name { margin-left: 12rpx; font-size: 26rpx; flex: 1; }
.lg__pct { color: var(--sub); font-size: 24rpx; }
.lg__amt {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  min-width: 120rpx;
  text-align: right;
}

/* 近半年趋势 */
.trend {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 260rpx;
  padding-bottom: 8rpx;
}
.bar { flex: 1; display: flex; flex-direction: column; align-items: center; }
.bar__val {
  height: 28rpx;
  line-height: 28rpx;
  color: var(--sub);
  font-size: 20rpx;
}
.bar__wrap {
  height: 160rpx;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
}
/* 单柱视图：柱子加宽，圆角柔和 */
.bar__exp {
  width: 28rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--expense);
}
.bar__inc {
  width: 28rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--income);
}
.bar__lab { margin-top: 12rpx; color: var(--sub); font-size: 20rpx; }

.tiplegend { display: flex; gap: 24rpx; margin-top: 24rpx; }
.tiplegend__i { display: flex; align-items: center; color: var(--text2); font-size: 22rpx; }
.tiplegend__d { width: 20rpx; height: 20rpx; border-radius: 6rpx; margin-right: 8rpx; }
.tiplegend__d.is-exp { background: var(--expense); }
.tiplegend__d.is-inc { background: var(--income); }

.empty { padding: 80rpx 0; text-align: center; color: var(--sub); font-size: 26rpx; }
.pad { height: 40rpx; }
