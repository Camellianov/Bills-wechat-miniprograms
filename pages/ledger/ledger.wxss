.page {
  min-height: 100vh;
  background: var(--bg);
}

.errbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--line2);
}
.errbar__t { flex: 1; color: var(--text2); font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
}

.sec {
  margin: 24rpx 32rpx;
  padding: 28rpx 24rpx;
  background: var(--card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow);
}
.sec__head { display: flex; align-items: center; padding-bottom: 20rpx; }
.sec__t { font-size: 30rpx; font-weight: 600; }

/* 辅助说明收进「!」符号 */
.ihelp {
  width: 36rpx;
  height: 36rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--line2);
  color: var(--sub);
  font-size: 22rpx;
}

/* 账本行：当前账本用浅蓝底标识 */
.row {
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 20rpx;
  border-radius: var(--r-m);
}
.row.is-on { background: var(--brand-weak); }
.row__main { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.row__name { font-size: 28rpx; }
.row__role { margin-top: 4rpx; color: var(--sub); font-size: 22rpx; }
.row__cur { color: var(--brand-text); font-size: 22rpx; }
.row__btn { margin-left: 20rpx; color: var(--brand-text); font-size: 26rpx; }
/* 删除弱化，不用红色 */
.row__btn--del { color: var(--sub); }

.empty { padding: 60rpx 0; text-align: center; color: var(--sub); font-size: 26rpx; }

.add {
  margin: 24rpx 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-m);
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

/* 弹层 */
.emask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 900;
  background: rgba(22, 24, 28, 0.3);
  display: flex;
  align-items: flex-end;
}
.epanel {
  width: 100%;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
}
.epanel__title {
  text-align: center;
  font-size: 26rpx;
  color: var(--sub);
  padding-bottom: 24rpx;
}

.erow {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid var(--line);
}
.erow--tall { height: auto; min-height: 96rpx; padding: 24rpx 0; }
.erow__k { width: 128rpx; color: var(--sub); font-size: 26rpx; }
.erow__input { flex: 1; text-align: right; font-size: 28rpx; }

/* 颜色选择：选中用外环标识，不改变色块本身 */
.ecolors { display: flex; flex-wrap: wrap; gap: 20rpx; margin-left: auto; }
.ecolors__i {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}
.ecolors__i.is-on { box-shadow: 0 0 0 4rpx var(--brand-line); }

.etip { padding-top: 16rpx; color: var(--sub); font-size: 22rpx; }

.ebtns { display: flex; gap: 16rpx; margin-top: 28rpx; }
.ebtn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-m);
  font-size: 30rpx;
  font-weight: 600;
}
.ebtn--cancel { background: var(--line2); color: var(--text2); }
.ebtn--save { background: var(--brand); color: #fff; }
