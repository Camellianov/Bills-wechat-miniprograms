.page {
  min-height: 100vh;
  background: var(--bg);
}

.errbar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #fff2f0;
  border-bottom: 2rpx solid #ffd6cf;
}
.errbar__t { flex: 1; color: #c0341b; font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--expense);
  color: #fff;
  font-size: 24rpx;
}

.sec {
  margin: 24rpx 28rpx 0;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
}
.sec__head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.sec__t { font-size: 28rpx; font-weight: 600; }

.row {
  display: flex;
  align-items: center;
  height: 104rpx;
  padding: 0 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.row:last-child { border-bottom: 0; }
.row.is-on { background: rgba(43, 108, 255, 0.06); }
.row__main {
  margin-left: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.row__name { font-size: 28rpx; }
.row__role { margin-top: 4rpx; color: var(--sub); font-size: 22rpx; }
.row__cur { color: var(--brand); }
.row__btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 24rpx;
}
.row__btn--del {
  margin-left: 12rpx;
  background: rgba(255, 91, 74, 0.12);
  color: var(--expense);
}

.empty { padding: 32rpx 0; text-align: center; color: #c2c8d2; font-size: 26rpx; }

.add {
  margin: 32rpx 28rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.tip { color: var(--sub); font-size: 22rpx; }
.tip--pad { padding: 16rpx 28rpx 0; }

/* 新建弹层 */
.emask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 900;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.epanel {
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx 40rpx;
}
.epanel__title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding-bottom: 16rpx;
}
.erow {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 2rpx solid var(--line);
}
.erow__k { width: 128rpx; color: var(--sub); font-size: 26rpx; }
.erow__input { flex: 1; text-align: right; font-size: 28rpx; }
.erow--tall { height: auto; min-height: 88rpx; padding: 20rpx 0; align-items: flex-start; }

.ecolors {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 6rpx;
}
.ecolors__i {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}
.ecolors__i.is-on {
  border: 4rpx solid var(--brand);
  box-shadow: 0 0 0 4rpx rgba(43, 108, 255, 0.15);
}

.etip { padding-top: 16rpx; color: var(--sub); font-size: 22rpx; }

.ebtns { display: flex; gap: 16rpx; margin-top: 28rpx; }
.ebtn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.ebtn--cancel { background: #f6f7f9; color: var(--sub); }
.ebtn--save { background: var(--brand); color: #fff; }
