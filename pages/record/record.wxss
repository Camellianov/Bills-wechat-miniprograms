.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  padding: 0 20rpx 20rpx;
}

.errbar {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  margin-bottom: 12rpx;
  background: #fff2f0;
  border-radius: 12rpx;
}
.errbar__t { flex: 1; color: #c0341b; font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--expense);
  color: #fff;
  font-size: 24rpx;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx 8rpx;
}
.seg { display: flex; gap: 12rpx; }
.seg__i {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 30rpx;
  background: #fff;
  color: var(--sub);
  font-size: 26rpx;
}
.seg__i.is-on { background: var(--brand); color: #fff; }
.sync { margin-left: 16rpx; color: #c45c00; font-size: 22rpx; }
.mng { margin-left: auto; color: var(--brand); font-size: 22rpx; }

/* 分类：5 列网格 */
.cats {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0;
  background: var(--card);
  border-radius: 16rpx;
}
.cat {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
}
.cat.is-on { background: rgba(43, 108, 255, 0.1); }
.cat__em { font-size: 40rpx; line-height: 1.2; }
.cat__name { margin-top: 8rpx; font-size: 22rpx; color: var(--sub); }
.cat.is-on .cat__name { color: var(--brand); }

/* 加号：纯 CSS 绘制，不用字符 */
.plus {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f6f7f9;
}
.plus::before,
.plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--brand);
  transform: translate(-50%, -50%);
}
.plus::before { width: 20rpx; height: 4rpx; }
.plus::after { width: 4rpx; height: 20rpx; }

/* 日期 */
.date {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
  background: var(--card);
  border-radius: 16rpx;
}
.date__k { font-size: 26rpx; color: var(--sub); }
.date__v {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}

/* 金额显示行 */
.amt {
  display: flex;
  align-items: baseline;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  background: var(--card);
  border-radius: 16rpx;
}
.amt__cur { font-size: 32rpx; color: var(--sub); }
.amt__num {
  margin-left: 16rpx;
  font-size: 68rpx;
  font-weight: 600;
  color: var(--expense);
}
.amt__num.is-income { color: var(--income); }

/* 数字键盘 */
.kb {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.key {
  width: calc((100% - 16rpx) / 3);
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: 12rpx;
}
.key__t { font-size: 40rpx; }
.key.is-del { background: #eceef2; }
.key__del { font-size: 36rpx; color: var(--sub); }

/* 备注 */
.note {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 24rpx;
  margin-top: 12rpx;
  background: var(--card);
  border-radius: 16rpx;
}
.note__k { font-size: 26rpx; color: var(--sub); }
.note__input { flex: 1; margin-left: 20rpx; font-size: 28rpx; }

/* 保存 */
.save {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: var(--brand);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.save.is-off { opacity: 0.6; }

/* 弹层 */
.emask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 900;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.epanel {
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx 40rpx;
}
.epanel__title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding-bottom: 16rpx;
}
.erow {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 2rpx solid var(--line);
}
.erow__k { width: 96rpx; color: var(--sub); font-size: 26rpx; }
.erow__input { flex: 1; text-align: right; font-size: 28rpx; }
.erow--tall { height: auto; min-height: 88rpx; padding: 20rpx 0; }

.eemoji { display: flex; gap: 20rpx; margin-left: auto; }
.eemoji__i {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f6f7f9;
  border: 2rpx solid transparent;
}
.eemoji__i.is-on { background: rgba(43, 108, 255, 0.12); border-color: var(--brand); }
.eemoji__t { font-size: 40rpx; }

.etip { padding-top: 16rpx; color: var(--sub); font-size: 22rpx; }

.ebtns { display: flex; gap: 16rpx; margin-top: 28rpx; }
.ebtn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.ebtn--cancel { background: #f6f7f9; color: var(--sub); }
.ebtn--save { background: var(--brand); color: #fff; }
