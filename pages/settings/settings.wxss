.page {
  min-height: 100vh;
  background: var(--bg);
}

.errbar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #fff2f0;
  border-bottom: 2rpx solid #ffd6cf;
}
.errbar__t { flex: 1; color: #c0341b; font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--expense);
  color: #fff;
  font-size: 24rpx;
}

.sec {
  margin: 24rpx 28rpx 0;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
}
.sec__head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.sec__t { font-size: 28rpx; font-weight: 600; }
.sec__n { margin-left: auto; color: var(--sub); font-size: 22rpx; }

/* 货币符号 */
.cur {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 16rpx;
}
.cur__i {
  width: 33.3333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.cur__i.is-on {
  background: rgba(43, 108, 255, 0.1);
  border-color: var(--brand);
}
.cur__s { font-size: 40rpx; font-weight: 600; }
.cur__n { margin-top: 6rpx; color: var(--sub); font-size: 22rpx; }
.cur__i.is-on .cur__n { color: var(--brand); }

/* 月度预算 */
.bud {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.bud__cur { font-size: 32rpx; color: var(--sub); }
.bud__input { flex: 1; margin-left: 16rpx; font-size: 36rpx; font-weight: 600; }

.btns { display: flex; gap: 16rpx; padding: 20rpx 24rpx; }
.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.btn--ghost { background: #f6f7f9; color: var(--sub); }
.btn--go { background: var(--brand); color: #fff; }

/* 导出日期范围 */
.range {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}
.range__i {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f6f7f9;
}
.range__k { color: var(--sub); font-size: 24rpx; }
.range__v { margin-left: auto; font-size: 28rpx; }

.quick {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
}
.quick__i {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 24rpx;
}
.quick__i.is-on { background: rgba(43, 108, 255, 0.12); color: var(--brand); }

.enote {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 操作按钮 */
.act {
  margin: 20rpx 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
}
.act--danger {
  background: #fff2f0;
  color: var(--expense);
}
.act.is-off { opacity: 0.5; }

.tip { padding: 12rpx 24rpx 20rpx; color: var(--sub); font-size: 22rpx; }

/* 弹层 */
.emask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 900;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.epanel {
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx 40rpx;
}
.epanel__title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding-bottom: 16rpx;
}
.efile {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 8rpx;
}
.efile__n { font-size: 28rpx; }
.efile__c { margin-top: 8rpx; color: var(--sub); font-size: 22rpx; }

.ewarn {
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #fff2f0;
  color: #c0341b;
  font-size: 24rpx;
}

.erow {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 2rpx solid var(--line);
}
.erow__k { width: 96rpx; color: var(--sub); font-size: 26rpx; }
.erow__input { flex: 1; text-align: right; font-size: 28rpx; }

.etip { padding-top: 16rpx; color: var(--sub); font-size: 22rpx; }

.ebtns { display: flex; gap: 16rpx; margin-top: 28rpx; }
.ebtn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.ebtn--cancel { background: #f6f7f9; color: var(--sub); }
.ebtn--save { background: var(--brand); color: #fff; }
.ebtn--danger { background: var(--expense); color: #fff; }
