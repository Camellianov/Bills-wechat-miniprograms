.page {
  min-height: 100vh;
  background: var(--bg);
}

.errbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--line2);
}
.errbar__t { flex: 1; color: var(--text2); font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
}

.sec {
  margin: 24rpx 32rpx;
  padding: 28rpx 24rpx;
  background: var(--card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow);
}
.sec__head { display: flex; align-items: center; padding-bottom: 20rpx; }
.sec__t { font-size: 30rpx; font-weight: 600; }
.sec__ops { margin-left: auto; display: flex; align-items: center; gap: 24rpx; }
.sec__restore { color: var(--text2); font-size: 24rpx; }
.sec__add { color: var(--brand-text); font-size: 24rpx; }

/* 辅助说明收进「!」符号 */
.ihelp {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--line2);
  color: var(--sub);
  font-size: 22rpx;
}

/* 分类行：不画分割线，靠留白区隔 */
.row {
  display: flex;
  align-items: center;
  height: 104rpx;
}
.row__em { font-size: 36rpx; }
.row__name { margin-left: 20rpx; font-size: 28rpx; flex: 1; }
.row__tag {
  padding: 4rpx 12rpx;
  border-radius: var(--r-s);
  background: var(--line2);
  color: var(--sub);
  font-size: 20rpx;
}
.row__btn { margin-left: 20rpx; color: var(--brand-text); font-size: 26rpx; }
/* 删除弱化，不用红色 */
.row__btn--del { color: var(--sub); }

.empty { padding: 60rpx 0; text-align: center; color: var(--sub); font-size: 26rpx; }
.pad { height: 40rpx; }

/* 弹层 */
.emask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 900;
  background: rgba(22, 24, 28, 0.3);
  display: flex;
  align-items: flex-end;
}
.epanel {
  width: 100%;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
}
.epanel__title {
  text-align: center;
  font-size: 26rpx;
  color: var(--sub);
  padding-bottom: 24rpx;
}

.erow {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid var(--line);
}
.erow__k { width: 96rpx; color: var(--sub); font-size: 26rpx; }
.erow__input { flex: 1; text-align: right; font-size: 28rpx; }

.etype { display: flex; gap: 16rpx; margin-left: auto; }
.etype__i {
  width: 128rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: var(--line2);
  color: var(--text2);
  font-size: 26rpx;
}
.etype__i.is-on { background: var(--brand-weak); color: var(--brand-text); }

.epick { padding: 24rpx 0; }
.epick__k { color: var(--sub); font-size: 26rpx; }
.epick__box { height: 320rpx; margin-top: 16rpx; }
.egrid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.egrid__i {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-m);
  background: var(--line2);
  border: 1rpx solid transparent;
}
.egrid__i.is-on { background: var(--brand-weak); border-color: var(--brand-line); }
.egrid__t { font-size: 36rpx; }

.ebtns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.ebtn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-m);
  font-size: 30rpx;
  font-weight: 600;
}
.ebtn--cancel { background: var(--line2); color: var(--text2); }
.ebtn--save { background: var(--brand); color: #fff; }
