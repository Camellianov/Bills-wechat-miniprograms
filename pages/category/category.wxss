.page {
  height: 100vh;
  background: var(--bg);
}

.errbar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #fff2f0;
  border-bottom: 2rpx solid #ffd6cf;
}
.errbar__t { flex: 1; color: #c0341b; font-size: 24rpx; }
.errbar__btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: var(--expense);
  color: #fff;
  font-size: 24rpx;
}

.sec {
  margin: 24rpx 28rpx 0;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
}
.sec__head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.sec__t { font-size: 28rpx; font-weight: 600; }

.sec__ops {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
}
.sec__restore {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 22rpx;
}
.sec__add {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(43, 108, 255, 0.12);
  color: var(--brand);
  font-size: 22rpx;
}

.row {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.row:last-child { border-bottom: 0; }
.row__em { font-size: 40rpx; }
.row__name { margin-left: 20rpx; font-size: 28rpx; flex: 1; }
.row__tag {
  margin-right: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 20rpx;
}
.row__btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 24rpx;
}
.row__btn--del {
  margin-left: 12rpx;
  background: rgba(255, 91, 74, 0.12);
  color: var(--expense);
}

.empty { padding: 32rpx 0; text-align: center; color: #c2c8d2; font-size: 26rpx; }
.tip { padding: 24rpx 28rpx 0; color: var(--sub); font-size: 22rpx; }
.pad { height: 40rpx; }

/* 弹层 */
.emask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 900;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.epanel {
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx 40rpx;
}
.epanel__title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding-bottom: 16rpx;
}
.erow {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 2rpx solid var(--line);
}
.erow__k { width: 96rpx; color: var(--sub); font-size: 26rpx; }
.erow__input { flex: 1; text-align: right; font-size: 28rpx; }

.etype { display: flex; gap: 16rpx; margin-left: auto; }
.etype__i {
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background: #f6f7f9;
  color: var(--sub);
  font-size: 26rpx;
}
.etype__i.is-on { background: rgba(43, 108, 255, 0.12); color: var(--brand); }

.epick { display: flex; flex-direction: column; padding-top: 16rpx; min-height: 0; }
.epick__k { color: var(--sub); font-size: 26rpx; }
.epick__box {
  margin-top: 12rpx;
  max-height: 420rpx;
  min-height: 0;
}
.egrid { display: flex; flex-wrap: wrap; }
.egrid__i {
  width: 16.6666%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.egrid__i.is-on { background: rgba(43, 108, 255, 0.12); border-color: var(--brand); }
.egrid__t { font-size: 40rpx; }

.ebtns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.ebtn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.ebtn--cancel { background: #f6f7f9; color: var(--sub); }
.ebtn--save { background: var(--brand); color: #fff; }
