<privacy-mask show="{{masked}}" />

<scroll-view class="page" scroll-y enhanced show-scrollbar="{{false}}">
  <view wx:if="{{initError}}" class="errbar">
    <text class="errbar__t">{{initError}}</text>
    <view class="errbar__btn" bindtap="onRetry">重试</view>
  </view>

  <view class="sec">
    <view class="sec__head">
      <text class="sec__t">支出分类</text>
      <view class="sec__ops">
        <view class="sec__restore" data-type="expense" bindtap="onRestore">恢复默认</view>
        <view class="sec__add" data-type="expense" bindtap="onAdd">+ 新增</view>
        <view class="ihelp" data-t="内置分类也可改名、换图标、删除；已记过账的分类不能删除。" bindtap="onTipTap">!</view>
      </view>
    </view>
    <view wx:for="{{expenseCats}}" wx:key="id" class="row">
      <text class="row__em">{{item.emoji}}</text>
      <text class="row__name">{{item.name}}</text>
      <text wx:if="{{item.builtin}}" class="row__tag">内置</text>
      <view class="row__btn" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
      <view class="row__btn row__btn--del" data-id="{{item.id}}" bindtap="onDel">删除</view>
    </view>
    <view wx:if="{{!expenseCats.length}}" class="empty">暂无支出分类</view>
  </view>

  <view class="sec">
    <view class="sec__head">
      <text class="sec__t">收入分类</text>
      <view class="sec__ops">
        <view class="sec__restore" data-type="income" bindtap="onRestore">恢复默认</view>
        <view class="sec__add" data-type="income" bindtap="onAdd">+ 新增</view>
      </view>
    </view>
    <view wx:for="{{incomeCats}}" wx:key="id" class="row">
      <text class="row__em">{{item.emoji}}</text>
      <text class="row__name">{{item.name}}</text>
      <text wx:if="{{item.builtin}}" class="row__tag">内置</text>
      <view class="row__btn" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
      <view class="row__btn row__btn--del" data-id="{{item.id}}" bindtap="onDel">删除</view>
    </view>
    <view wx:if="{{!incomeCats.length}}" class="empty">暂无收入分类</view>
  </view>

  <view class="pad"></view>
</scroll-view>

<view wx:if="{{dlg}}" class="emask" bindtap="onDlgClose" catchtouchmove="noop">
  <view class="epanel" catchtap="noop">
    <view class="epanel__title">{{dlgMode==='edit'?'修改分类':'新增分类'}}</view>

    <view class="erow">
      <text class="erow__k">名称</text>
      <input class="erow__input" value="{{dlgName}}" placeholder="最多 8 个字" maxlength="8" bindinput="onDlgName" />
    </view>

    <view wx:if="{{dlgMode==='add'}}" class="erow">
      <text class="erow__k">类型</text>
      <view class="etype">
        <view class="etype__i {{dlgType==='expense'?'is-on':''}}" data-type="expense" bindtap="onDlgType">支出</view>
        <view class="etype__i {{dlgType==='income'?'is-on':''}}" data-type="income" bindtap="onDlgType">收入</view>
      </view>
    </view>

    <view class="epick">
      <text class="epick__k">选择图标</text>
      <scroll-view class="epick__box" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="egrid">
          <view wx:for="{{emojiLib}}" wx:key="*this"
            class="egrid__i {{dlgEmoji===item?'is-on':''}}"
            data-e="{{item}}" bindtap="onDlgEmoji">
            <text class="egrid__t">{{item}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="ebtns">
      <view class="ebtn ebtn--cancel" bindtap="onDlgClose">取消</view>
      <view class="ebtn ebtn--save" bindtap="onDlgSave">保存</view>
    </view>
  </view>
</view>
