.pmask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #16181c;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pmask__box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pmask__icon {
  font-size: 96rpx;
}

.pmask__title {
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 32rpx;
}

.pmask__tip {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
}
